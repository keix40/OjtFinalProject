# Database (Aiven MySQL)
DB_URL=jdbc:mysql://HOST:PORT/DATABASE?sslMode=REQUIRED&serverTimezone=UTC
DB_USER=your_user
DB_PASSWORD=your_password

# JWT (HS512 — at least 64 characters)
JWT_SECRET=your-local-dev-secret-at-least-64-characters-long-for-testing-only

# Email — Resend HTTPS API (recommended on Render; SMTP is often blocked)
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=Britium Gallery <onboarding@resend.dev>

# Optional SMTP fallback (local dev only if Resend is not set)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your@gmail.com
# MAIL_PASSWORD=your-app-password

# CORS (comma-separated frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://ojt-final-project.vercel.app

# Auth cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
