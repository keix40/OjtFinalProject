# Copy to .env and fill in real values. NEVER commit .env to git.
# ROTATE all secrets that were previously committed to application.properties.

# Database
DB_URL=jdbc:mysql://localhost:3306/ecommerce
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT (minimum 64 characters for HS512)
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-characters-long-for-production
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Auth cookies — set COOKIE_SECURE=true when serving over HTTPS
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

# Auth rate limiting (in-memory per IP; use Redis for multi-instance production)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_RPM=30

# Upload directories (relative to JVM working directory unless absolute path)
APP_UPLOAD_DIR=uploads
APP_RETURN_IMAGES_DIR=return_images
APP_REVIEW_UPLOAD_DIR=review
APP_PRODUCT_UPLOAD_DIR=product_image
APP_CATEGORY_UPLOAD_DIR=brand_and_category_image
APP_EVENT_UPLOAD_DIR=event

# Mail (e.g. Gmail app password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password

# Optional: Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: IPQualityScore
IPQS_API_KEY=

# Redis (optional — shared JWT blacklist + auth rate limits for multi-instance)
REDIS_ENABLED=false
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Payment processor adapter: local (last-4 interim) or stripe (stub until configured)
PAYMENT_PROCESSOR=local

# Frontend build — inject at build time, never commit real keys
GOOGLE_MAPS_API_KEY=

# JPA (use validate or none in production)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
