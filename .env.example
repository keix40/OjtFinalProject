# Copy to .env and fill in real values. NEVER commit .env to git.
# ROTATE all secrets that were previously committed to application.properties.

# Database
DB_URL=jdbc:mysql://localhost:3306/ecommerce
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT (minimum 64 characters for HS512)
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-characters-long-for-production
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Auth cookies — set COOKIE_SECURE=true when serving over HTTPS
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

# Mail (e.g. Gmail app password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password

# Optional: Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: IPQualityScore
IPQS_API_KEY=

# JPA (use validate or none in production)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
